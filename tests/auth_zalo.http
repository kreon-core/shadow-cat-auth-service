###
POST http://localhost:8080/api/v1/auth/zalo
Accept: application/json
Content-Type: application/json
X-Client-ID: <client-id>
X-Client-Signature: Client <signature_provided_by_server>

{
    // Forwarded from client SDK
    "channel": "<zalo-channel>(h5zl||inapp)",
    "uid": "<zalo-uid>",
    "timestamp": "<zalo-timestamp>",
    "utm_campaign": "<zalo-utm-campaign>",
    "utm_medium": "<zalo-utm-medium>",
    "utm_source": "<zalo-utm-source>",
    "sign": "<zalo-signature>",

    // Extra info from client SDK (optional)
    "display_name": "<zalo-user-display-name>(optional)",
    "avatar_url": "<zalo-user-avatar-url>(optional)",
}

